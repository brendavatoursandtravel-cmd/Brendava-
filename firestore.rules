rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Itineraries: anyone authenticated can read active ones
    // Only the operator who owns it can write
    match /itineraries/{itineraryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.operatorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.operatorId == request.auth.uid;
    }

    // Bookings: client can create; client & operator can read their own
    match /bookings/{bookingId} {
      allow create: if request.auth != null
                    && request.resource.data.clientId == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.clientId == request.auth.uid
                      || resource.data.operatorId == request.auth.uid);
      allow update: if request.auth != null
                    && resource.data.operatorId == request.auth.uid;
    }
  }
}
